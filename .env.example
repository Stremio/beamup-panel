# Runtime
NODE_ENV=production
SERVER_PORT=4000

# Development proxy ports
REACT_APP_SERVER_PORT=5000
REACT_APP_PORT=3000

# GitHub OAuth
CLIENT_ID=your_github_client_id
CLIENT_SECRET=your_github_client_secret

# Slack bot
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=C0123456789
SLACK_SIGNING_SECRET=your_slack_app_signing_secret

# Slack reports
SLACK_DAILY_REPORT_TIME=21:00
SLACK_ISSUES_HISTORY_DAYS=14

# Sessions and history storage
SESSION_EXPIRE=2592000000
SESSIONS_FOLDER=../sessions

# Swarm nodes
NODE_MANAGER=stremio-beamup-swarm-0
NODE_PREFIX=stremio-beamup-swarm-
NODE_USER=beamup
NODE_SSH_KEY=/home/dokku/.ssh/id_ed25519_sync